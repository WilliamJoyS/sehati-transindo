[Unit]
Description=Sehati verified off-server backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sehati
ExecStart=/usr/bin/python3 /opt/sehati/deploy/offsite_backup.py
User=root
UMask=0077
TimeoutStartSec=30min
