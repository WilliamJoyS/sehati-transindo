# Copy to secrets/backup.env on the VPS and chmod 600.
# Use a separate remote backup repository, NOT a path on this VPS.
RESTIC_REPOSITORY=sftp:backup-user@backup-host:/backups/sehati
RESTIC_PASSWORD_FILE=/opt/sehati/secrets/restic_password
# For S3-compatible storage instead, use e.g. s3:https://endpoint/bucket/sehati
# AWS_ACCESS_KEY_ID=fill-on-server-only
# AWS_SECRET_ACCESS_KEY=fill-on-server-only
